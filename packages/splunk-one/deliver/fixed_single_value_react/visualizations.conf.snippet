# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf
# (merge with existing contents; do not duplicate stanza names)
#
# NOTE: This viz hard-codes the Splunk formatter namespace segment `splunk-one`.
# If you install into an app whose id is NOT `splunk-one`, formatter props may not apply
# until you align `visualization.amd.jsx` `NS` with your app id.

[fixed_single_value_react]
label = Fixed single value (React) (splunk-one)
description = React-based single value with delta and fixed min/max sparkline. Expects column-major results with at least one numeric field (last numeric column is used for the series).
default_height = 200
search_fragment = | timechart span=1h avg(my_metric) as value
supports_drilldown = 0
supports_trellis = 0
