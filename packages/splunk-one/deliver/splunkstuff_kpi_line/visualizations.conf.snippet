# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf

[splunkstuff_kpi_line]
label = SplunkStuff — KPI loaded line (vanilla AMD, full options)
description = Readable AMD single-value + line chart; LineChart-style layout, padding, stroke, threshold styling, and hover annotation options.
default_height = 200
search_fragment = | timechart span=1h avg(my_metric) as value
supports_drilldown = 0
supports_trellis = 0
