# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf

[splunkstuff_kpi_sparkline]
label = BGDHamp - KPI + sparkline (JavaScript)
description = Single value with delta and footer sparkline. Accepts Single Value–like one-metric results or _time + numeric series; optional valueField.
default_height = 172
search_fragment = | timechart span=1h avg(my_metric) as value
supports_drilldown = 0
supports_trellis = 0
