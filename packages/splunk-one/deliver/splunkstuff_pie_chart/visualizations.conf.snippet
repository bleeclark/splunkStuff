# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf
# Splunk Enterprise 9.4.x custom visualization registration

[splunkstuff_pie_chart]
label = SplunkStuff - Data pie (JavaScript)
description = Vanilla JavaScript pie/donut contribution inspector with selectable formatter controls, outside slice labels, field overrides, Other bucket, compare deltas, and slice click tokens.
default_height = 300
search_fragment = | stats count by category_field
supports_drilldown = 1
supports_trellis = 0
