<?xml version="1.0"?>
<dashboard version="1.1">
    <label>SplunkStuff custom viz gallery</label>
    <description>Canonical gallery: one vanilla JavaScript implementation and one React implementation for each distinct SplunkStuff visualization family.</description>
    <row>
        <panel>
            <title>Simple small viz - JavaScript</title>
            <search id="gallery_simple_small_js">
                <query>
| makeresults count=5
| streamstats count as value
| eval _time = relative_time(now(), "-" . (5 - value) . "m@m")
| fields _time value
                </query>
                <earliest>-15m</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.simple_small_viz">
                <search base="gallery_simple_small_js" />
                <option name="display.visualizations.custom.so_BUI_pickulationts.simple_small_viz.label">Latest count</option>
            </viz>
            <table>
                <title>Data</title>
                <search base="gallery_simple_small_js" />
                <option name="count">5</option>
                <option name="drilldown">none</option>
            </table>
        </panel>
        <panel>
            <title>Simple small viz - React</title>
            <search id="gallery_simple_small_react">
