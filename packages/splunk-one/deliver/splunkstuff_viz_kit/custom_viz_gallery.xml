<?xml version="1.0"?>
<dashboard version="1.1">
    <label>SplunkStuff custom viz gallery</label>
    <description>Simple XML demo for simple_small_viz, fixed_single_value, and fixed_loaded_line. Each panel uses one base search; tables show the same data the viz uses. In Search and Reporting, open Visualization and filter by SplunkStuff.</description>
    <row>
        <panel>
            <title>Simple small viz (SplunkStuff)</title>
            <search id="splunkstuff_gallery_simple_small_viz">
                <query>
| makeresults count=5
| streamstats count as value
| eval _time = relative_time(now(), "-" . (5 - value) . "m@m")
| fields _time value
                </query>
                <earliest>-15m</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.simple_small_viz">
                <search base="splunkstuff_gallery_simple_small_viz" />
                <option name="display.visualizations.custom.so_BUI_pickulationts.simple_small_viz.label">Latest count</option>
            </viz>
            <table>
                <title>Data for this viz</title>
                <search base="splunkstuff_gallery_simple_small_viz" />
                <option name="count">5</option>
                <option name="dataOverlayMode">none</option>
                <option name="drilldown">none</option>
            </table>
        </panel>


        <panel>
            <title>Fixed single value (SplunkStuff)</title>
            <search id="splunkstuff_gallery_fixed_single_value">
                <query>
| makeresults count=72
| streamstats count as n
| eval _time = relative_time(now(), "-" . (n - 1) . "m@m")
| eval value = 18 + ((n * 9) % 62)
| fields _time value
| sort 0 _time
| tail 20
                </query>
                <earliest>-4h@h</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.fixed_single_value">
                <search base="splunkstuff_gallery_fixed_single_value" />
            </viz>
            <table>
                <title>Data for this viz (latest 20 by _time; oldest→newest, bottom = viz headline)</title>
                <search base="splunkstuff_gallery_fixed_single_value">
                    <query>| sort 0 _time | tail 20</query>
                </search>
                <option name="count">20</option>
                <option name="dataOverlayMode">none</option>
                <option name="drilldown">none</option>
                <option name="sortCol">_time</option>
                <option name="sortDir">asc</option>
            </table>
        </panel>

        <panel>
            <title>Fixed loaded line (SplunkStuff)</title>
            <search id="splunkstuff_gallery_fixed_loaded_line">
                <query>
| makeresults count=72
| streamstats count as n
| eval _time = relative_time(now(), "-" . (n - 1) . "m@m")
| eval value = 28 + ((n * 13) % 52)
| fields _time value
| sort 0 _time
| tail 20
                </query>
                <earliest>-4h@h</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.fixed_loaded_line">
                <search base="splunkstuff_gallery_fixed_loaded_line" />
                <option name="display.visualizations.custom.so_BUI_pickulationts.fixed_loaded_line.showHover">true</option>
            </viz>
            <table>
                <title>Data for this viz (latest 20 by _time; oldest→newest, bottom = viz headline)</title>
                <search base="splunkstuff_gallery_fixed_loaded_line">
                    <query>| sort 0 _time | tail 20</query>
                </search>
                <option name="count">20</option>
                <option name="dataOverlayMode">none</option>
                <option name="drilldown">none</option>
                <option name="sortCol">_time</option>
                <option name="sortDir">asc</option>
            </table>
        </panel>
    </row>
</dashboard>
