    <row>
        <panel>
            <title>Fixed single value - JavaScript</title>
            <search id="gallery_fixed_single_value_js">
                <query>
| makeresults count=72
| streamstats count as n
| eval _time = relative_time(now(), "-" . (n - 1) . "m@m")
| eval value = 18 + ((n * 9) % 62)
| fields _time value
| sort 0 _time
| tail 20
                </query>
                <earliest>-4h@h</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.fixed_single_value">
                <search base="gallery_fixed_single_value_js" />
            </viz>
            <table>
                <title>Data (latest 20 by _time, oldest to newest)</title>
                <search base="gallery_fixed_single_value_js" />
                <option name="count">20</option>
                <option name="drilldown">none</option>
                <option name="sortCol">_time</option>
                <option name="sortDir">asc</option>
            </table>
        </panel>
