{
  "name": "@splunk/splunk-one",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node bin/build.js build",
    "build:hover-harness": "node bin/build-hover-harness.js",
    "package:viz": "yarn build && node bin/package-viz-app.js",
    "package:manual-viz": "node bin/package-manual-viz.js",
    "verify:trend-colors": "node bin/verify-trend-colors.js",
    "verify:viz-hover": "node bin/verify-viz-hover.js",
    "verify:radial-meter-arc": "node bin/verify-radial-meter-arc.js",
    "verify:radial-meter": "node bin/verify-radial-meter-arc.js",
    "verify:gallery-vizs": "node bin/verify-radial-meter-arc.js && node bin/verify-sparkline-features.js && node bin/verify-pie-topn.js && node bin/verify-viz-deploy.js",
    "verify:risk-dashboard": "node bin/verify-risk-dashboard.js",
    "test:risk": "node --test test/risk/*.test.mjs",
    "sync:splunk-gallery": "node bin/sync-splunk-gallery.js",
    "sync:splunk-visualizations-conf": "node bin/sync-splunk-visualizations-conf.js",
    "dev:splunk-viz": "node bin/refresh-splunk-viz-dev.js",
    "eslint": "eslint src --ext \".ts,.tsx,.js,.jsx\"",
    "eslint:fix": "eslint src --ext \".ts,.tsx,.js,.jsx\" --fix",
    "link:app": "node bin/build.js link",
    "lint": "yarn run eslint && yarn run stylelint",
    "start": "node bin/build.js watch",
    "stylelint": "stylelint \"src/**/*.{ts,tsx,js,jsx}\" --config stylelint.config.js",
    "test:playwright": "playwright test --config playwright.config.js"
  },
  "dependencies": {
    "@splunk/react-page": "^8.3.1",
    "@splunk/react-ui": "^5.9.1",
    "@splunk/splunk-utils": "^3.4.0",
    "@splunk/themes": "^1.7.0",
    "@splunk/visualization-context": "^28.5.3",
    "@splunk/visualizations": "^28.5.3",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "styled-components": "^5.3.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@playwright/test": "^1.60.0",
    "@splunk/babel-preset": "^4.0.0",
    "@splunk/eslint-config": "^5.1.0",
    "@splunk/stylelint-config": "^5.0.0",
    "@splunk/webpack-configs": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "babel-loader": "^8.3.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-webpack": "^0.13.4",
    "eslint-plugin-import": "^2.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.5.3",
    "shelljs": "^0.8.5",
    "stylelint": "^15.11.0",
    "typescript": "^5.8.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
