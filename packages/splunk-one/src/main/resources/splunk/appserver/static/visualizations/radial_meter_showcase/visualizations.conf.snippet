# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf

[radial_meter_showcase]
label = BGDHamp — Radial meter (Splunk tutorial)
description = Radial gauge for a single numeric value (Splunk 9.4 custom viz tutorial). Use | stats count or a single numeric field.
default_height = 220
search_fragment = | stats count
supports_drilldown = 0
supports_trellis = 0
