# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf

[refactor_viz_manual]
label = SplunkStuff — Refactor viz manual (clone of KPI verbose)
description = Same UX as splunkstuff_kpi_line_verbose; AMD + per-viz splunkstuff*.js (synced from repo _shared). REFACTOR_VIZ_MANUAL_DEBUG for traces.
default_height = 200
search_fragment = | timechart span=1h avg(my_metric) as value
supports_drilldown = 0
supports_trellis = 0
