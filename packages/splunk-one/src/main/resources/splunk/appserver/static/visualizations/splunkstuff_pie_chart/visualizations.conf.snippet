# Paste into: $SPLUNK_HOME/etc/apps/<APP_ID>/default/visualizations.conf

[splunkstuff_pie_chart]
label = SplunkStuff - Data pie inspector
description = Pie/donut contribution inspector with selectable formatter controls, outside slice label callouts, field overrides, data quality banner, tooltip inspector, Other breakdown, compare deltas, and slice click tokens.
default_height = 300
search_fragment = | stats count by category_field
supports_drilldown = 1
supports_trellis = 0
