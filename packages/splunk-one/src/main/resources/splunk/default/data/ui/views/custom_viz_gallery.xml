    <row>
        <panel>
            <title>Data pie — Top N + Other (SplunkStuff)</title>
            <search id="splunkstuff_gallery_pie_chart">
                <query>
| makeresults count=14
| streamstats count as row
| eval category=substr("ABCDEFGHIJKLMN", row, 1)
| eval value=row * 10
| stats sum(value) as value by category
| sort category
                </query>
                <earliest>-1s</earliest>
                <latest>now</latest>
            </search>
            <viz type="so_BUI_pickulationts.splunkstuff_pie_chart">
