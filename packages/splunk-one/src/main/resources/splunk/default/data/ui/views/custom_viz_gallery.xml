                <option name="display.visualizations.custom.so_BUI_pickulationts.splunkstuff_pie_chart.title">Top 5 + Other (demo)</option>
                <option name="display.visualizations.custom.so_BUI_pickulationts.splunkstuff_pie_chart.background">#1B2A41</option>
                <option name="display.visualizations.custom.so_BUI_pickulationts.splunkstuff_pie_chart.textColor">#FFFFFF</option>
